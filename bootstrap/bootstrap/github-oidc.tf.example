# NOT APPLIED. Reference design for keyless GitHub Actions -> AWS access (OIDC).
# Blocked in this account: the organization SCP explicitly denies
# iam:CreateOpenIDConnectProvider. In a real organization this would go to the
# cloud/security team as an access request. Rename to .tf to use where allowed.

resource "aws_iam_openid_connect_provider" "github" {
  url            = "https://token.actions.githubusercontent.com"
  client_id_list = ["sts.amazonaws.com"]
}

resource "aws_iam_role" "github_plan" {
  name                 = "secure-lab-github-plan"
  max_session_duration = 3600

  # Trust ONLY tokens from this repo, on the main branch or a pull request
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Federated = aws_iam_openid_connect_provider.github.arn }
      Action    = "sts:AssumeRoleWithWebIdentity"
      Condition = {
        StringEquals = { "token.actions.githubusercontent.com:aud" = "sts.amazonaws.com" }
        StringLike = {
          "token.actions.githubusercontent.com:sub" = [
            "repo:FrancisObeng/secure-aws-platform-lab:ref:refs/heads/main",
            "repo:FrancisObeng/secure-aws-platform-lab:pull_request"
          ]
        }
      }
    }]
  })
}

# Read-only: CI could run plan but never change anything
resource "aws_iam_role_policy_attachment" "github_plan_readonly" {
  role       = aws_iam_role.github_plan.name
  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess"
}